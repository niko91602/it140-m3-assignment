<mxfile host="65bd71144e">
    <diagram id="paycheck-calculator-page" name="Paycheck Calculator">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="Paycheck Calculator-title" value="&lt;h2&gt;Paycheck Calculator Flowchart&lt;/h2&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="160" y="30" width="530" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="Start" style="strokeWidth=2;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="385" y="120" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="input" value="Get hoursWorked" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
                    <mxGeometry x="365" y="200" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="edge1" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="input">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="decision" value="hoursWorked &gt; 40?" style="strokeWidth=2;shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="355" y="300" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="edge2" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="input" target="decision">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="processTrue" value="totalPay = (40 * 20) + &#xa;((hoursWorked - 40) * 30)" style="whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="560" y="310" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="edgeTrue" value="True" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision" target="processTrue">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="processFalse" value="totalPay = hoursWorked * 20" style="whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="140" y="310" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="edgeFalse" value="False" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="decision" target="processFalse">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="output" value="Output totalPay" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
                    <mxGeometry x="365" y="440" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="edgeTrueOut" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="processTrue" target="output">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="650" y="470"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edgeFalseOut" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="processFalse" target="output">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="220" y="470"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="end" value="End" style="strokeWidth=2;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="385" y="540" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="edgeEnd" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="output" target="end">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
